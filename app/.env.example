# Database
DB_HOST="host"
DB_PORT="3306"
DB_DATABASE="database"
DB_USER="user"
DB_PASSWORD="password"

# Database migrations (dbmate, run with "npm run migrate"). Same database as above, as a URL.
DATABASE_URL="mysql://user:password@host:3306/database"

# Authentication secret (change in each different environment to prevent access with cookies from other environments)
JWT_SECRET="test"

# Admin
ADMIN_KEY="test"

# Misc
IS_PREVIEW_SITE="false"

# Reverse proxy addresses to trust for the client IP (Express "trust proxy"), e.g. "uniquelocal" or "loopback".
# Must be address names or subnets; numbers and "true" are not supported. Leave unset when not behind a proxy.
#TRUST_PROXY="uniquelocal"
