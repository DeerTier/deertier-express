{
  "name": "deertier",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "dev": "node --watch-path=. ./bin/www",
    "db:start": "docker compose -f ../docker-compose.yml up -d migrate",
    "db:stop": "docker compose -f ../docker-compose.yml stop db",
    "db": "dbmate --migrations-dir ../db/migrations --schema-file ../db/schema.sql",
    "migrate": "dbmate --migrations-dir ../db/migrations --no-dump-schema up"
  },
  "dependencies": {
    "aspnet-identity-pw": "^1.0.2",
    "async-mutex": "^0.5.0",
    "cookie-parser": "^1.4.7",
    "debug": "~2.6.9",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "hbs": "~4.0.4",
    "he": "^1.2.0",
    "http-errors": "~1.6.3",
    "jsonwebtoken": "^9.0.2",
    "log4js": "^6.9.1",
    "morgan": "~1.9.1",
    "mysql2": "^3.15.3",
    "node-cache": "^5.1.2",
    "temporal-polyfill": "^0.3.0"
  },
  "devDependencies": {
    "dbmate": "^2.36.0"
  }
}
