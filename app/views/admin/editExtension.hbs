<div id="adminEdit">
  <div class="addTimeTitle">
    {{Title}}
  </div>

  <br />

  <form method="post">
    <div class="addTimeForm">
      Subdomain: (e.g. "ext" for ext.deertier.com)<br />
      <input type="text" class="adminTextField" name="name" maxlength="63" value="{{Extension.Name}}" /><br />

      Description: (shown as the subtitle in the site header)<br />
      <input type="text" class="adminTextField" name="description" maxlength="200" value="{{Extension.Description}}" /><br />
    </div>

    <input class="genericButton" type="submit" value="Save" />
  </form>

  <p class="adminBackLink">
    <a href="/admin/manageExtensions">Back to Extension Boards</a>
  </p>

  {{#if Message}}
    <div class="statusLiteral">
      {{Message}}
    </div>
  {{/if}}
</div>
