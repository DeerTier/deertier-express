<div id="login">
  <h1>Change Password</h1>
  <br />

  <form method="post">
    <div class="loginSignUpForm">
      Current password:
      <input type="password" name="currentPassword" />
      <br />
      New password:
      <input type="password" name="newPassword" />
      <br />
      Confirm new password:
      <input type="password" name="confirmedNewPassword" />
      <br />
    </div>

    <input class="genericButton" type="submit" value="Submit" />   
  </form>

  <br />
  <h2>Create API Key</h2>
  <p>Creating a new API key below will invalidate your old one. <br />It will be displayed briefly after generation and then never again so make sure to copy it.</p>
  <form method="post" action="/account/createApiKey">
    <input class="genericButton" type="submit" value="Create" />
  </form>

  <div class="statusLiteral">
    {{{Message}}}
  </div>
  <br />
</div>