{{#if IsAuthenticated}}

  <span>Welcome, <a href="/Account/ChangePassword">{{Username}}</a></span>
  <span> | </span>
  {{#if (or IsModerator IsAdministrator)}}
    <a href="/Admin">Admin</a>
    <span> | </span>
  {{/if}}
  <a href="/Account/LogOut?returnUrl={{encodeURIComponent RequestUrl}}">Log Out</a>

{{else}}

  <a href="/Account/LogIn">Log In</a>
  <span> | </span>
  <a href="/Account/SignUp">Sign Up</a>

{{/if}}