<div id="ntscNavSection" class="navSection">
  <div class="navSectionContent" style="display: block">
    {{#if OpenSection}}
      {{#each Sections}}
        <h3 class="navSectionExpander">
          {{Name}}
          {{#if (eq ../OpenSection Name)}}
            <span class="open"/>
          {{else}}
            <span/>
          {{/if}}
        </h3>
        {{#if (eq ../OpenSection Name)}}
          <ul class="open">
        {{else}}
          <ul>
        {{/if}}
        {{#each Categories}}
          <li><a href="{{escapeHtmlAttribute LinkUrl}}">{{ShortName}}</a></li>
        {{/each}}
        </ul>
      {{/each}}
    {{else}}
      {{#each Sections}}
        <h3 class="navSectionExpander">
          {{Name}}
          {{#if @first}}
            <span class="open"/>
          {{else}}
            <span/>
          {{/if}}
        </h3>
        {{#if @first}}
          <ul class="open">
        {{else}}
          <ul>
        {{/if}}
        {{#each Categories}}
          <li><a href="{{escapeHtmlAttribute LinkUrl}}">{{ShortName}}</a></li>
        {{/each}}
        </ul>
      {{/each}}
    {{/if}}
  </div>
</div>

<div id="wikiNavSection" class="navSection navExternalLinkSection">
  <a href="https://wiki.supermetroid.run/Categories" target="_blank" class="link">More at the wiki</a>
</div>
